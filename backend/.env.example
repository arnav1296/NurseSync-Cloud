# Local development settings. On AWS these come from SSM Parameter Store (/nursesync/*).

# PostgreSQL (Amazon RDS in the cloud; any Postgres locally)
DATABASE_URL=postgresql://nursesync:password@localhost:5432/nursesync

# Amazon Cognito (terraform output: cognito_user_pool_id, cognito_client_id)
AWS_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=ap-southeast-2_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional AWS features (empty = disabled)
S3_BUCKET=
SNS_TOPIC_ARN=
INTERNAL_API_TOKEN=

# Voice and AI (optional: without these the app runs and nurses type their notes)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
SARVAM_API_KEY=sk_...
SARVAM_STT_MODEL=saaras:v3
