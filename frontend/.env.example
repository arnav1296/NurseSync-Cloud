# NurseSync API. Locally the FastAPI server; in the cloud build this is empty and the
# app calls /api on its own CloudFront domain.
VITE_API_BASE_URL=http://localhost:8000

# Amazon Cognito (terraform output: cognito_user_pool_id, cognito_client_id)
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
